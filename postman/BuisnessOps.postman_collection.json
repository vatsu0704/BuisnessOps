              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"manager.{{runId}}@test.buisnessops.dev\",\n  \"password\": \"TestPass123!\",\n  \"name\": \"Demo Manager\",\n  \"businessName\": \"Manager Solo Business {{runId}}\",\n  \"industry\": \"RETAIL\",\n  \"country\": \"IN\",\n  \"defaultCurrency\": \"INR\",\n  \"timezone\": \"Asia/Kolkata\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "There is no 'join an existing business' signup path — every signup creates its own solo business. This user's solo business is unused; they get invited into the owner's real business in the Memberships folder."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Manager candidate signup succeeds (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
