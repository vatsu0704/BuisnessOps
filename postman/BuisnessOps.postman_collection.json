            },
            "description": "Requires the target email to already have an account (run 'Signup (Manager Candidate)' first) — there's no invite-by-email flow yet, membership is created ACTIVE immediately. Requires OWNER or ADMIN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Membership created (201)', function () {",
