                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Manager Scoping Checks",
      "item": [
        {
          "name": "Get Branch A as Manager (Allowed)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/businesses/{{businessId}}/branches/{{branchAId}}",
              "host": ["{{baseUrl}}"],
              "path": ["businesses", "{{businessId}}", "branches", "{{branchAId}}"]
            },
            "description": "Run 'Login (Manager)' after granting branch access, so managerToken is set. Expect 200 — the manager is scoped to this branch."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 - manager is scoped to Branch A', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Branch B as Manager (Blocked - 403)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/businesses/{{businessId}}/branches/{{branchBId}}",
              "host": ["{{baseUrl}}"],
              "path": ["businesses", "{{businessId}}", "branches", "{{branchBId}}"]
            },
            "description": "Phase 0 exit criteria: a branch-scoped manager must not be able to read another branch's data in the same business, even knowing its real id. Expect 403."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403 - manager is NOT scoped to Branch B', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Branches as Manager (Scoped)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/businesses/{{businessId}}/branches",
              "host": ["{{baseUrl}}"],
              "path": ["businesses", "{{businessId}}", "branches"]
            },
            "description": "The list endpoint filters, rather than 403ing, since there's no single branchId to reject — same underlying access list."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('List includes Branch A but excludes Branch B', function () {",
                  "  const ids = pm.response.json().map(b => b.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('branchAId'));",
                  "  pm.expect(ids).to.not.include(pm.collectionVariables.get('branchBId'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Branch as Unauthenticated (Blocked - 401)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/businesses/{{businessId}}/branches/{{branchAId}}",
              "host": ["{{baseUrl}}"],
              "path": ["businesses", "{{businessId}}", "branches", "{{branchAId}}"]
            },
            "description": "No Authorization header at all. Expect 401 from requireAuth, before tenant/role logic even runs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 - no Authorization header', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Data Ingestion (Owner/Admin)",
      "item": [
        {
          "name": "Create Data Source",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"provider\": \"CSV_UPLOAD\",\n  \"displayName\": \"Manual CSV Import\",\n  \"branchId\": \"{{branchAId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/businesses/{{businessId}}/data-sources",
              "host": ["{{baseUrl}}"],
              "path": ["businesses", "{{businessId}}", "data-sources"]
            },
            "description": "Registers a CSV upload channel for a branch. Requires OWNER or ADMIN. Run after the Branches folder so branchAId is set."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Data source created (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('dataSourceId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Upload CSV",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
            },
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": {
              "raw": "{{baseUrl}}/businesses/{{businessId}}/data-sources/{{dataSourceId}}/upload",
              "host": ["{{baseUrl}}"],
              "path": ["businesses", "{{businessId}}", "data-sources", "{{dataSourceId}}", "upload"]
            },
            "description": "Multipart upload — field name must be \"file\". Requires OWNER or ADMIN, and dataSourceId to be set (run 'Create Data Source' first).\n\nPostman never embeds actual file bytes in a collection, so select the file yourself: Body > form-data > the \"file\" row > choose postman/sample-sales.csv (a ready-made sample with a grouped transaction, a standalone row, and one deliberately invalid row to see PARTIAL status)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
