{
  "expo": {
    "name": "HisabKitab",
    "slug": "biziq",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biziq.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.biziq.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4539E3"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "./plugins/withAndroid12SplashScreen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withAndroidArchitectures",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HisabKitab uses your location to confirm you're punching in or out from the branch."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27bf882f-c5dc-46b7-9837-50a919a771d1"
      }
    }
  }
}
