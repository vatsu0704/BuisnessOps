{
  "expo": {
    "name": "KitnaPay",
    "slug": "kitnapay",
    "scheme": "kitnapay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "androidStatusBar": {
      "barStyle": "dark-content"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kitnapay.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kitnapay.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4539E3"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withAndroidArchitectures",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KitnaPay uses your location to confirm you're punching in or out from the branch."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27bf882f-c5dc-46b7-9837-50a919a771d1"
      }
    }
  }
}
