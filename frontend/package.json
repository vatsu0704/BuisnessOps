{
  "name": "kitnapay-frontend",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "brand:assets": "node scripts/generate-brand-assets.js",
    "lint:i18n": "node scripts/check-i18n-parity.js",
    "lint:errors": "node scripts/check-error-parity.js",
    "lint:permissions": "node scripts/check-permission-parity.js",
    "adb:reverse": "node scripts/adb-reverse.js",
    "prestart": "node scripts/adb-reverse.js",
    "preandroid": "node scripts/check-firebase-package.js && node scripts/adb-reverse.js",
    "lint:backend-i18n": "node scripts/check-backend-i18n-parity.js",
    "lint:notification-prose": "node scripts/check-notification-prose.js",
    "lint:receipt-prose": "node scripts/check-receipt-prose.js",
    "lint:patched-deps": "node scripts/check-patched-deps.js",
    "postinstall": "patch-package --error-on-fail",
    "build:play": "node scripts/build-play-release.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "axios": "^1.7.7",
    "expo": "~54.0.37",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^23.16.8",
    "qrcode-generator": "^2.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^14.1.3",
    "react-native": "0.81.5",
    "react-native-reanimated": "~3.19.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.10",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "//overrides": [
    "Pinned transitive versions, all of them security patches. See the",
    "'Dependency overrides' section of CLAUDE.md for why each one is here and why",
    "it is safe. Re-check this list when the Expo SDK is upgraded: an override that",
    "has become unnecessary is a version pin nobody asked for.",
    "image-size is the one whose only patched line changed the interface its consumer",
    "(the metro inside @expo/metro) calls, so it needs patches/@expo+metro++metro+0.83.3.patch,",
    "applied by patch-package on postinstall. Neither works without the other.",
    "expo.install.exclude keeps react-native-reanimated on 3.x: 4.x needs the New",
    "Architecture, and this app runs on the old one (app.json newArchEnabled: false)."
  ],
  "overrides": {
    "image-size": "^2.0.4",
    "postcss": "^8.5.28",
    "uuid": "^11.1.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    }
  }
}
