{
  "name": "biziq-frontend",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "lint:i18n": "node scripts/check-i18n-parity.js",
    "lint:errors": "node scripts/check-error-parity.js",
    "lint:permissions": "node scripts/check-permission-parity.js",
    "adb:reverse": "node scripts/adb-reverse.js",
    "prestart": "node scripts/adb-reverse.js",
    "preandroid": "node scripts/adb-reverse.js",
    "lint:backend-i18n": "node scripts/check-backend-i18n-parity.js",
    "lint:notification-prose": "node scripts/check-notification-prose.js",
    "lint:patched-deps": "node scripts/check-patched-deps.js",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-community/datetimepicker": "8.0.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "axios": "^1.7.7",
    "expo": "~51.0.0",
    "expo-build-properties": "~0.12.5",
    "expo-dev-client": "~4.0.29",
    "expo-device": "~6.0.2",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.1",
    "expo-haptics": "~13.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-localization": "~15.0.3",
    "expo-location": "~17.0.1",
    "expo-notifications": "~0.28.19",
    "expo-print": "~13.0.1",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.1",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "i18next": "^23.16.8",
    "qrcode-generator": "^2.0.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^14.1.3",
    "react-native": "0.74.5",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.2.79",
    "babel-plugin-module-resolver": "^5.0.3",
    "patch-package": "^8.0.1",
    "typescript": "~5.3.3"
  },
  "private": true,
  "//overrides": [
    "Pinned transitive versions, all of them security patches. See the",
    "'Dependency overrides' section of CLAUDE.md for why each one is here and why",
    "it is safe. Re-check this list when the Expo SDK is upgraded: an override that",
    "has become unnecessary is a version pin nobody asked for.",
    "react-native is NOT a security fix - it removes a bogus second copy of React",
    "Native that npm installs to satisfy @react-native/virtualized-lists' 'peer",
    "react-native: *'.",
    "tar and image-size are the two whose only patched line changed the interface",
    "its consumer calls, so each needs a matching patch in patches/, applied by",
    "patch-package on postinstall. Neither override works without its patch."
  ],
  "overrides": {
    "react-native": "0.74.5",
    "@xmldom/xmldom": "^0.8.15",
    "ajv": "^8.18.0",
    "decode-uri-component": "^0.5.0",
    "fast-xml-parser": "^5.11.1",
    "image-size": "^2.0.4",
    "postcss": "^8.5.28",
    "send": "^0.19.2",
    "tar": "^7.5.22",
    "uuid": "^11.1.1",
    "@react-native/virtualized-lists": {
      "react-native": "0.74.5"
    }
  }
}
