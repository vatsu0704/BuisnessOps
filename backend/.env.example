PORT=4000

# Not decoration — it switches behaviour. `production` turns on the strict
# JWT_SECRET rules below and turns the access log from morgan's coloured
# terminal format into one JSON object per line, which is what a hosted log
# collector can actually parse. A deployment that forgets it runs with
# weak-secret checking off and logs nothing anything can read.
# `test` silences logging entirely. See Docs/DEPLOYMENT.md.
NODE_ENV=development

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/buisnessops?schema=public"

# Signs every session token. GENERATE YOUR OWN — do not copy a value from here
# or from any other checkout:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# src/config/env.js refuses to start the server without it, and in production
# also refuses a known placeholder or anything under 32 characters. A token is
# valid for seven days, so a weak or shared secret is a way for anybody holding
# it to sign in as any user in any business.
#
# Changing it signs everyone out, which is exactly what you want if it leaks.
JWT_SECRET=

# Which browser origins may call this API, comma-separated. Leave unset in
# development: that allows any origin, which is what `npm run web` at
# localhost:8081 needs. The native app sends no Origin header and is unaffected
# either way.
#
# SET THIS IN PRODUCTION if you serve the web build, e.g.
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Push notifications. Optional: with this unset the API starts normally and
# records notifications without sending them, which is how CI and the test
# suite run. See Docs/FIREBASE_SETUP.md.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
