PORT=4000
NODE_ENV=development

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/buisnessops?schema=public"

JWT_SECRET=change-me

# Push notifications. Optional: with this unset the API starts normally and
# records notifications without sending them, which is how CI and the test
# suite run. See Docs/FIREBASE_SETUP.md.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
