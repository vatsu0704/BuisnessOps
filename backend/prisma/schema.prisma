generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Phase 0 — Foundations (see /Docs/database-table.md section 3 for full rationale)
// ---------------------------------------------------------------------------

enum Industry {
  RETAIL
  FOOD_BEVERAGE
  SERVICES
  FRANCHISE_OTHER
}

enum Locale {
  EN
  HI
  GU
  MR
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

// What a role is ALLOWED to do lives in src/permissions/catalog.js, not here.
// This enum is only the vocabulary; the capability matrix is the authority.
//
// Appended rather than ordered by seniority: nothing sorts by this column, and
// relying on enum declaration order is a trap worth never setting.
enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  // The central order desk. Sees every branch's supply orders and none of their
  // staff records — see branch:allAccess vs staff:viewAllBranches.
  WAREHOUSE
  // The branch operator: counter billing, supply orders, expenses, and their
  // own branch's staff including pay.
  CASHIER
  // Carries supply orders, marks them delivered, posts delays with a reason.
  DELIVERY_AGENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REVOKED
}

model Business {
  id              String   @id @default(uuid())
  name            String
  industry        Industry
  country         String
  defaultCurrency String
  defaultLocale   Locale   @default(EN)
  timezone        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Standing weekly off, 0 = Sunday … 6 = Saturday, matching JS getUTCDay().
  // [] means the business works every day. Week-offs are PAID by construction:
  // they are excluded from the payroll divisor, so missing one costs nothing —
  // see workCalendar.service.js.
  weeklyOffDays Int[] @default([0])

  // What a working day with no Attendance row means at payroll time.
  // PRESENT makes payroll exception-based: managers mark absences and leave,
  // and silence means the person worked. ABSENT makes attendance mandatory.
  // PRESENT is the default because under ABSENT any business that doesn't
  // punch every single day would see every salary silently zeroed.
  unmarkedWorkingDayStatus AttendanceStatus @default(PRESENT)

  branches              Branch[]
  memberships           Membership[]
  dataSourceConnections DataSourceConnection[]
  products              Product[]
  transactions          Transaction[]
  inventoryItems        InventoryItem[]
  inventoryUsages       InventoryUsage[]
  staffMembers          StaffMember[]
  attendanceRecords     Attendance[]
  salarySlips           SalarySlip[]
  invites               Invite[]
  holidays              Holiday[]

  @@map("businesses")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// A pending invite for an email with no BizIQ account yet. Deliberately not
// a Membership row: Membership.userId is required (a membership is always
// for a real person), so "invited, but not a person here yet" needs its own
// model. Signup checks for a match on the submitted email and, if found,
// joins that business with the stored role/branches instead of creating a
// new one — see auth.service.js and invite.service.js.
model Invite {
  id         String       @id @default(uuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  role       MembershipRole
  branchIds  String[]     @default([])
  status     InviteStatus @default(PENDING)
  invitedAt  DateTime     @default(now())
  acceptedAt DateTime?

  @@unique([businessId, email])
  @@index([email, status])
  @@map("invites")
}

model Branch {
  id         String       @id @default(uuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  code       String
  city       String?
  region     String?
  country    String?
  latitude   Decimal?     @db.Decimal(9, 6)
  longitude  Decimal?     @db.Decimal(9, 6)
  timezone   String
  currency   String?
  status     BranchStatus @default(ACTIVE)
  openedAt   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Opt-in punch-in geofencing (Attendance module): both must be set for a
  // branch to enforce a radius. Nullable because most branches created
  // before this module, or created without a precise address, shouldn't
  // suddenly start rejecting punches.
  geofenceRadiusMeters Int?

  // Per-branch weekly off, overriding the business default. Prisma has no
  // nullable scalar list, and an empty array is a legitimate value ("this
  // branch works seven days"), so the override is an explicit flag plus a list
  // rather than a sentinel. The override wins whole, never merged.
  weeklyOffOverride Boolean @default(false)
  weeklyOffDays     Int[]   @default([])

  branchAccess          BranchAccess[]
  dataSourceConnections DataSourceConnection[]
  productDetails        ProductBranchDetail[]
  transactions          Transaction[]
  inventoryUsages       InventoryUsage[]
  staffMembers          StaffMember[]
  attendanceRecords     Attendance[]
  salarySlips           SalarySlip[]
  holidays              Holiday[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("branches")
}

// Paid non-working days. branchId null applies to the whole business; a branch
// row overrides a business-wide row for that branch on that date.
//
// Postgres treats NULL as distinct in a unique index, so @@unique below does
// NOT prevent two business-wide rows on the same date. Prisma 5 cannot emit
// NULLS NOT DISTINCT, and hand-adding a partial index would leave permanent
// drift against this file. workCalendar.service.js pre-checks on create, and
// its calculator dedupes into a Map keyed by date, so a duplicate that slips
// through can never skew the payroll maths — only the admin list would show
// the row twice.
model Holiday {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  name       String
  // false is the rare unpaid-shutdown case: still not a working day, but not
  // paid either. isPaid only affects how the payslip labels the day, never the
  // divisor — a holiday is excluded from working days regardless.
  isPaid     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([businessId, branchId, date])
  @@index([businessId, date])
  @@map("holidays")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  name            String?
  phone           String?
  preferredLocale Locale     @default(EN)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships  Membership[]
  staffMembers StaffMember[]

  @@map("users")
}

model Membership {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       MembershipRole
  status     MembershipStatus @default(ACTIVE)
  invitedAt  DateTime?
  joinedAt   DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  branchAccess    BranchAccess[]
  attendanceMarks Attendance[]

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

// Explicit branch scoping for MANAGER/STAFF roles. OWNER/ADMIN roles ignore
// this table and have implicit all-branch access within their business
// (enforced in the tenant-resolution middleware, not here).
model BranchAccess {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([membershipId, branchId])
  @@map("branch_access")
}

// ---------------------------------------------------------------------------
// Phase 1 — Data Ingestion (see /Docs/database-table.md section 4 for full rationale)
// ---------------------------------------------------------------------------

enum DataSourceStatus {
  CONNECTED
  ERROR
  DISCONNECTED
  PENDING
}

enum SyncFrequency {
  MANUAL
  HOURLY
  DAILY
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  OTHER
  MIXED
  // A counter order has no payment step (requirement 1), but Transaction
  // requires a payment method. Writing OTHER instead would put a permanent lie
  // into the cash-vs-digital mix metric that Phase 5 is meant to compute, so
  // "we did not ask" gets to say so.
  UNSPECIFIED
}

enum TransactionStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

enum InventoryUsageSource {
  SYSTEM_CALCULATED
  MANUAL_ENTRY
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

// One row per connected POS/data source per business (or per branch, for POS
// systems that authenticate per-location). `provider` is an open string, not
// a closed enum — adding a new POS vendor is data, never a migration.
model DataSourceConnection {
  id            String           @id @default(uuid())
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  provider      String
  displayName   String
  authConfig    Json?
  status        DataSourceStatus @default(PENDING)
  syncFrequency SyncFrequency    @default(MANUAL)
  lastSyncedAt  DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  syncRuns     SyncRun[]
  transactions Transaction[]

  @@index([businessId])
  @@map("data_source_connections")
}

// Append-only ingestion job log — needed to show "last synced: 2 hours ago"
// and to debug ingestion failures.
model SyncRun {
  id                     String               @id @default(uuid())
  dataSourceConnectionId String
  dataSourceConnection   DataSourceConnection @relation(fields: [dataSourceConnectionId], references: [id], onDelete: Cascade)
  startedAt              DateTime             @default(now())
  finishedAt             DateTime?
  status                 SyncRunStatus        @default(RUNNING)
  recordsIngested        Int                  @default(0)
  errorMessage           String?
  sourceFileName         String?

  @@index([dataSourceConnectionId])
  @@map("sync_runs")
}

// Business-level catalog (shared across branches); price/availability varies
// per branch via ProductBranchDetail.
model Product {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  category   String?
  unit       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branchDetails ProductBranchDetail[]
  lineItems     LineItem[]

  @@index([businessId])
  @@map("products")
}

model ProductBranchDetail {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  costPrice Decimal @db.Decimal(12, 2)
  sellPrice Decimal @db.Decimal(12, 2)
  isActive  Boolean @default(true)

  @@unique([productId, branchId])
  @@map("product_branch_details")
}

// The core sales fact table. Every metric in the query engine (Phase 2)
// ultimately aggregates this.
model Transaction {
  id                     String                @id @default(uuid())
  businessId             String
  business               Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId               String
  branch                 Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dataSourceConnectionId String?
  dataSourceConnection   DataSourceConnection? @relation(fields: [dataSourceConnectionId], references: [id], onDelete: SetNull)
  externalId             String?
  occurredAt             DateTime
  staffMemberId          String?
  staffMember            StaffMember?          @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  totalAmount            Decimal               @db.Decimal(12, 2)
  taxAmount              Decimal               @default(0) @db.Decimal(12, 2)
  discountAmount         Decimal               @default(0) @db.Decimal(12, 2)
  currency               String
  paymentMethod          PaymentMethod
  status                 TransactionStatus     @default(COMPLETED)
  createdAt              DateTime              @default(now())

  lineItems LineItem[]

  @@unique([branchId, externalId])
  @@index([businessId, branchId, occurredAt])
  @@map("transactions")
}

model LineItem {
  id                  String      @id @default(uuid())
  transactionId       String
  transaction         Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  quantity            Decimal     @db.Decimal(12, 3)
  unitPrice           Decimal     @db.Decimal(12, 2)
  lineTotal           Decimal     @db.Decimal(12, 2)
  costPriceSnapshot   Decimal?    @db.Decimal(12, 2)

  @@index([transactionId])
  @@map("line_items")
}

model InventoryItem {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  unit       String
  category   String?

  usageRecords InventoryUsage[]

  @@index([businessId])
  @@map("inventory_items")
}

// Daily usage/wastage per branch per item.
model InventoryUsage {
  id              String               @id @default(uuid())
  businessId      String
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem        @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  date            DateTime             @db.Date
  quantityUsed    Decimal              @db.Decimal(12, 3)
  quantityWasted  Decimal              @default(0) @db.Decimal(12, 3)
  wastageReason   String?
  costImpact      Decimal?             @db.Decimal(12, 2)
  source          InventoryUsageSource @default(MANUAL_ENTRY)

  @@index([businessId, branchId, date])
  @@map("inventory_usage")
}

// POS/HR record — distinct from User, because most cashiers/cooks never log
// into the app. userId links the two only when a staff member also has app
// access.
model StaffMember {
  id         String      @id @default(uuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  role       String
  externalId String?
  // Attendance/Salary module. Nullable: a StaffMember synced in from a POS
  // (Phase 1) has no payroll relationship with this app until an owner sets one.
  baseSalary Decimal?    @db.Decimal(12, 2)
  status     StaffStatus @default(ACTIVE)

  phone String?
  // Human-facing payroll id, printed on the payslip. Distinct from externalId,
  // which is the id this person carries in a POS system. Deliberately not
  // @unique: unique-with-NULLs in Postgres would still allow any number of
  // staff with no code, so it buys nothing here.
  employeeCode String?
  // Pro-rate a mid-month joiner or leaver. These shrink the NUMERATOR only —
  // days outside employment are excluded from present/absent but stay in
  // workingDays, so someone joining on the 15th earns roughly half a month.
  // Shrinking the divisor instead would pay them a full month, which is wrong.
  hiredOn  DateTime? @db.Date
  exitedOn DateTime? @db.Date
  // Pairs with status, so a deactivation is auditable rather than just a flag.
  deactivatedAt DateTime?
  notes         String?

  transactions      Transaction[]
  attendanceRecords Attendance[]
  salarySlips       SalarySlip[]

  @@index([businessId, branchId])
  @@index([businessId, status])
  @@map("staff_members")
}

// ---------------------------------------------------------------------------
// Attendance & Salary Slip module
// ---------------------------------------------------------------------------
// Attendance is the payroll-facing daily record - exactly one row per staff
// member per calendar day - with the punch geolocation and the status payroll
// actually reads.
//
// It was deliberately never folded into the old `Shift` model, which was a
// POS/rota concept: schedulable without ever happening, attributable to a
// Transaction, and more than one per staff member per day. `Shift` was dropped
// in the working-days payroll migration having never been written to by any
// code path; a real rota feature would reintroduce it rather than overload
// this table.

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum SalarySlipStatus {
  DRAFT
  FINALIZED
}

model Attendance {
  id            String           @id @default(uuid())
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffMemberId String
  staffMember   StaffMember      @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  date          DateTime         @db.Date
  status        AttendanceStatus @default(PRESENT)
  punchInAt     DateTime?
  punchInLat    Decimal?         @db.Decimal(9, 6)
  punchInLng    Decimal?         @db.Decimal(9, 6)
  punchOutAt    DateTime?
  punchOutLat   Decimal?         @db.Decimal(9, 6)
  punchOutLng   Decimal?         @db.Decimal(9, 6)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Who overrode this day, when it wasn't a punch. A nullable FK rather than a
  // bare id string so the row survives the membership being deleted. Cheap to
  // record now and impossible to backfill later.
  markedByMembershipId String?
  markedBy             Membership? @relation(fields: [markedByMembershipId], references: [id], onDelete: SetNull)

  // Doubles as the "no double-punching" guard the reference doc calls for.
  @@unique([staffMemberId, date])
  @@index([businessId, branchId, date])
  @@map("attendance")
}

// One row per staff member per payroll month. Regenerating for the same
// (staffMemberId, monthYear) overwrites the previous DRAFT rather than
// accumulating duplicates - see payroll.service.js. A FINALIZED slip is
// immutable and regeneration is refused.
model SalarySlip {
  id            String      @id @default(uuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  monthYear     String

  // The basis, snapshotted at generation. Without these a later change to the
  // weekly off, the holiday calendar or the person's salary would silently
  // restate a payslip the employee has already been shown.
  baseSalary  Decimal @db.Decimal(12, 2)
  workingDays Decimal @db.Decimal(5, 2)

  // Itemised day buckets, so the payslip can show its own arithmetic.
  // The first four count working days only; weeklyOff and holiday are outside
  // the divisor entirely and are listed so the employee sees they were paid.
  daysPresent   Decimal @default(0) @db.Decimal(5, 2)
  daysHalfDay   Decimal @default(0) @db.Decimal(5, 2)
  daysAbsent    Decimal @default(0) @db.Decimal(5, 2)
  daysLeave     Decimal @default(0) @db.Decimal(5, 2)
  // Working days still in the future when the slip was generated mid-month.
  daysPending   Decimal @default(0) @db.Decimal(5, 2)
  daysWeeklyOff Decimal @default(0) @db.Decimal(5, 2)
  daysHoliday   Decimal @default(0) @db.Decimal(5, 2)

  totalDaysWorked Decimal          @db.Decimal(5, 2)
  grossPay        Decimal          @db.Decimal(12, 2)
  deductions      Decimal          @default(0) @db.Decimal(12, 2)
  deductionNote   String?
  netPay          Decimal          @db.Decimal(12, 2)
  currency        String
  status          SalarySlipStatus @default(DRAFT)
  generatedAt     DateTime         @default(now())
  finalizedAt     DateTime?

  @@unique([staffMemberId, monthYear])
  @@index([businessId, monthYear])
  @@index([businessId, branchId, monthYear])
  @@map("salary_slips")
}
