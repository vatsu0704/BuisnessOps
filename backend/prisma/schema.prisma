generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Phase 0 — Foundations (see /Docs/database-table.md section 3 for full rationale)
// ---------------------------------------------------------------------------

enum Industry {
  RETAIL
  FOOD_BEVERAGE
  SERVICES
  FRANCHISE_OTHER
}

enum Locale {
  EN
  HI
  GU
  MR
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

// What a location IS, as opposed to where it is.
//
// A warehouse is a place the business occupies and staffs — people work there
// and punch in there — but it does not sell and it does not order raw material
// from itself. Modelling it as a Branch with a kind, rather than as its own
// table, is what makes attendance, geofencing, payroll and rosters work there
// on the day it is created: every one of those is already keyed on a branch,
// and a second location table would need all of them taught about it.
//
// The distinction it earns is enforced where goods move — see
// `assertTradingBranch` in counterOrder.service.js and supplyOrder.service.js.
enum BranchKind {
  BRANCH
  WAREHOUSE
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

// What a role is ALLOWED to do lives in src/permissions/catalog.js, not here.
// This enum is only the vocabulary; the capability matrix is the authority.
//
// Appended rather than ordered by seniority: nothing sorts by this column, and
// relying on enum declaration order is a trap worth never setting.
enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  // The central order desk. Sees every branch's supply orders and none of their
  // staff records — see branch:allAccess vs staff:viewAllBranches.
  WAREHOUSE
  // The branch operator: counter billing, supply orders, expenses, and their
  // own branch's staff including pay.
  CASHIER
  // Carries supply orders, marks them delivered, posts delays with a reason.
  DELIVERY_AGENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REVOKED
}

model Business {
  id              String   @id @default(uuid())
  name            String
  industry        Industry
  country         String
  defaultCurrency String
  defaultLocale   Locale   @default(EN)
  timezone        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Standing weekly off, 0 = Sunday … 6 = Saturday, matching JS getUTCDay().
  // [] means the business works every day. Week-offs are PAID by construction:
  // they are excluded from the payroll divisor, so missing one costs nothing —
  // see workCalendar.service.js.
  weeklyOffDays Int[] @default([0])

  // What a working day with no Attendance row means at payroll time.
  // PRESENT makes payroll exception-based: managers mark absences and leave,
  // and silence means the person worked. ABSENT makes attendance mandatory.
  // PRESENT is the default because under ABSENT any business that doesn't
  // punch every single day would see every salary silently zeroed.
  unmarkedWorkingDayStatus AttendanceStatus @default(PRESENT)

  branches              Branch[]
  memberships           Membership[]
  dataSourceConnections DataSourceConnection[]
  products              Product[]
  transactions          Transaction[]
  inventoryItems        InventoryItem[]
  inventoryUsages       InventoryUsage[]
  staffMembers          StaffMember[]
  attendanceRecords     Attendance[]
  salarySlips           SalarySlip[]
  invites               Invite[]
  holidays              Holiday[]
  counterOrders         CounterOrder[]
  dayCloses             DayClose[]
  supplyOrders          SupplyOrder[]
  supplyOrderCounter    SupplyOrderCounter?
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]

  @@map("businesses")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// A pending invite for an email with no BizIQ account yet. Deliberately not
// a Membership row: Membership.userId is required (a membership is always
// for a real person), so "invited, but not a person here yet" needs its own
// model. Signup checks for a match on the submitted email and, if found,
// joins that business with the stored role/branches instead of creating a
// new one — see auth.service.js and invite.service.js.
model Invite {
  id         String         @id @default(uuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  role       MembershipRole
  branchIds  String[]       @default([])
  status     InviteStatus   @default(PENDING)
  invitedAt  DateTime       @default(now())
  acceptedAt DateTime?

  @@unique([businessId, email])
  @@index([email, status])
  @@map("invites")
}

model Branch {
  id         String     @id @default(uuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  code       String
  // Defaults to BRANCH, so every location that already exists stays exactly
  // what it was and no backfill is needed.
  kind       BranchKind @default(BRANCH)
  city       String?
  region     String?
  country    String?

  // Where a delivery actually goes. city/region/country describe where the
  // branch IS, for reporting; they are not an address anybody can ride to.
  // A delivery agent carrying raw material to a branch they have never been to
  // needs the street, the building and the landmark, which is what this holds —
  // free text and multi-line, because an Indian address is not a fixed set of
  // fields and forcing one drops the half that matters ("behind the old post
  // office"). Nullable: every branch that existed before this column has none,
  // and a branch whose own staff know where it is never needs one.
  addressLine String?
  postalCode  String?
  latitude    Decimal?     @db.Decimal(9, 6)
  longitude   Decimal?     @db.Decimal(9, 6)
  timezone    String
  currency    String?
  status      BranchStatus @default(ACTIVE)
  openedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Opt-in punch-in geofencing (Attendance module): both must be set for a
  // branch to enforce a radius. Nullable because most branches created
  // before this module, or created without a precise address, shouldn't
  // suddenly start rejecting punches.
  geofenceRadiusMeters Int?

  // Per-branch weekly off, overriding the business default. Prisma has no
  // nullable scalar list, and an empty array is a legitimate value ("this
  // branch works seven days"), so the override is an explicit flag plus a list
  // rather than a sentinel. The override wins whole, never merged.
  weeklyOffOverride Boolean @default(false)
  weeklyOffDays     Int[]   @default([])

  branchAccess          BranchAccess[]
  dataSourceConnections DataSourceConnection[]
  productDetails        ProductBranchDetail[]
  // Products that exist only at this branch (requirement 4). Business-wide
  // products carry no branchId and are not in here.
  ownProducts           Product[]
  transactions          Transaction[]
  inventoryUsages       InventoryUsage[]
  staffMembers          StaffMember[]
  attendanceRecords     Attendance[]
  salarySlips           SalarySlip[]
  holidays              Holiday[]
  counterOrders         CounterOrder[]
  tokenCounters         BranchTokenCounter[]
  dayCloses             DayClose[]
  supplyOrders          SupplyOrder[]
  expenses              Expense[]

  @@unique([businessId, code])
  @@index([businessId])
  @@map("branches")
}

// Paid non-working days. branchId null applies to the whole business; a branch
// row overrides a business-wide row for that branch on that date.
//
// Postgres treats NULL as distinct in a unique index, so @@unique below does
// NOT prevent two business-wide rows on the same date. Prisma 5 cannot emit
// NULLS NOT DISTINCT, and hand-adding a partial index would leave permanent
// drift against this file. workCalendar.service.js pre-checks on create, and
// its calculator dedupes into a Map keyed by date, so a duplicate that slips
// through can never skew the payroll maths — only the admin list would show
// the row twice.
model Holiday {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  name       String
  // false is the rare unpaid-shutdown case: still not a working day, but not
  // paid either. isPaid only affects how the payslip labels the day, never the
  // divisor — a holiday is excluded from working days regardless.
  isPaid     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([businessId, branchId, date])
  @@index([businessId, date])
  @@map("holidays")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  name            String?
  phone           String?
  preferredLocale Locale     @default(EN)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships  Membership[]
  staffMembers StaffMember[]

  @@map("users")
}

model Membership {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       MembershipRole
  status     MembershipStatus @default(ACTIVE)
  invitedAt  DateTime?
  joinedAt   DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  branchAccess    BranchAccess[]
  attendanceMarks Attendance[]
  counterOrders   CounterOrder[]
  dayCloses       DayClose[]

  // Only the two membership links a QUERY needs are relations on SupplyOrder:
  // the cashier who placed it (per-branch reporting) and the agent carrying it
  // (their queue is a filter on this column). Who accepted, packed, dispatched
  // or verified a payment lives in SupplyOrderEvent instead — that table is the
  // audit trail, and repeating four more actor columns on the order would mean
  // two records of the same fact that can disagree.
  supplyOrdersPlaced SupplyOrder[]      @relation("SupplyOrderPlacedBy")
  supplyDeliveries   SupplyOrder[]      @relation("SupplyOrderDeliveryAgent")
  supplyOrderEvents  SupplyOrderEvent[] @relation("SupplyOrderEventActor")
  expensesRecorded   Expense[]          @relation("ExpenseRecordedBy")

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

// Explicit branch scoping for MANAGER/STAFF roles. OWNER/ADMIN roles ignore
// this table and have implicit all-branch access within their business
// (enforced in the tenant-resolution middleware, not here).
model BranchAccess {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([membershipId, branchId])
  @@map("branch_access")
}

// ---------------------------------------------------------------------------
// Phase 1 — Data Ingestion (see /Docs/database-table.md section 4 for full rationale)
// ---------------------------------------------------------------------------

enum DataSourceStatus {
  CONNECTED
  ERROR
  DISCONNECTED
  PENDING
}

enum SyncFrequency {
  MANUAL
  HOURLY
  DAILY
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  OTHER
  MIXED
  // A counter order has no payment step (requirement 1), but Transaction
  // requires a payment method. Writing OTHER instead would put a permanent lie
  // into the cash-vs-digital mix metric that Phase 5 is meant to compute, so
  // "we did not ask" gets to say so.
  UNSPECIFIED
}

enum TransactionStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

enum TransactionSource {
  // Came in through a CSV/Excel upload from someone's POS.
  POS_IMPORT
  // Rung up at the counter in this app (requirement 1).
  COUNTER
}

enum CounterOrderStatus {
  // Being rung up. Still editable, and the token is already issued so the
  // customer can be called.
  OPEN
  // Handed over. Still editable until the day is closed, because requirement 1
  // asks for exactly that.
  CLOSED
  // Cancelled. Projects as TransactionStatus.VOIDED, which the existing
  // `status: 'COMPLETED'` filter in getSalesSummary already excludes.
  VOID
}

enum InventoryUsageSource {
  SYSTEM_CALCULATED
  MANUAL_ENTRY
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

// One row per connected POS/data source per business (or per branch, for POS
// systems that authenticate per-location). `provider` is an open string, not
// a closed enum — adding a new POS vendor is data, never a migration.
model DataSourceConnection {
  id            String           @id @default(uuid())
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  provider      String
  displayName   String
  authConfig    Json?
  status        DataSourceStatus @default(PENDING)
  syncFrequency SyncFrequency    @default(MANUAL)
  lastSyncedAt  DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  syncRuns     SyncRun[]
  transactions Transaction[]

  @@index([businessId])
  @@map("data_source_connections")
}

// Append-only ingestion job log — needed to show "last synced: 2 hours ago"
// and to debug ingestion failures.
model SyncRun {
  id                     String               @id @default(uuid())
  dataSourceConnectionId String
  dataSourceConnection   DataSourceConnection @relation(fields: [dataSourceConnectionId], references: [id], onDelete: Cascade)
  startedAt              DateTime             @default(now())
  finishedAt             DateTime?
  status                 SyncRunStatus        @default(RUNNING)
  recordsIngested        Int                  @default(0)
  errorMessage           String?
  sourceFileName         String?

  @@index([dataSourceConnectionId])
  @@map("sync_runs")
}

// Business-level catalog (shared across branches); price/availability varies
// per branch via ProductBranchDetail.
model Product {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Requirement 4: "every branch can also add their own separate products".
  // NULL means the product belongs to the whole business and every branch sees
  // it; a branchId means only that branch does. Nullable rather than a separate
  // table because the two are the same thing at different scopes — a join table
  // would make "show me this branch's catalog" a union instead of one filter.
  //
  // SetNull rather than Cascade: deleting a branch should not silently delete
  // products, and a branch-only product whose branch is gone becoming
  // business-wide is a state someone can see and fix. Branches are closed via
  // BranchStatus rather than deleted in practice, so this is a backstop.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name     String
  sku      String?
  category String?
  unit     String

  // The business-wide default price. ProductBranchDetail overrides it per
  // branch, so a product priced the same everywhere needs one row rather than
  // one row per branch. Nullable because products created by CSV ingestion are
  // discovered from sales rows, which carry a unit price per line but no
  // catalog price — see ingestion.service.js.
  costPrice Decimal? @db.Decimal(12, 2)
  sellPrice Decimal? @db.Decimal(12, 2)

  // Withdraw a product from sale without deleting it. Deleting is not an option
  // once LineItem rows point at it: past sales must keep naming what was sold.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchDetails     ProductBranchDetail[]
  lineItems         LineItem[]
  counterOrderItems CounterOrderItem[]

  @@index([businessId])
  @@index([businessId, branchId])
  @@map("products")
}

model ProductBranchDetail {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  costPrice Decimal @db.Decimal(12, 2)
  sellPrice Decimal @db.Decimal(12, 2)
  isActive  Boolean @default(true)

  @@unique([productId, branchId])
  @@map("product_branch_details")
}

// The core sales fact table. Every metric in the query engine (Phase 2)
// ultimately aggregates this.
model Transaction {
  id                     String                @id @default(uuid())
  businessId             String
  business               Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId               String
  branch                 Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dataSourceConnectionId String?
  dataSourceConnection   DataSourceConnection? @relation(fields: [dataSourceConnectionId], references: [id], onDelete: SetNull)
  externalId             String?
  occurredAt             DateTime
  staffMemberId          String?
  staffMember            StaffMember?          @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  totalAmount            Decimal               @db.Decimal(12, 2)
  taxAmount              Decimal               @default(0) @db.Decimal(12, 2)
  discountAmount         Decimal               @default(0) @db.Decimal(12, 2)
  currency               String
  paymentMethod          PaymentMethod
  status                 TransactionStatus     @default(COMPLETED)

  // Where this sale came from. Both sources write through
  // salesProjection.service.js into this one table (Architecture Principle 4),
  // so without a discriminator "counter sales vs imported sales" would be
  // unanswerable — and the day-end export and the analytics grid both want to
  // ask it. @default backfills every existing row, all of which are imports.
  source TransactionSource @default(POS_IMPORT)

  createdAt DateTime @default(now())

  lineItems    LineItem[]
  counterOrder CounterOrder?

  @@unique([branchId, externalId])
  @@index([businessId, branchId, occurredAt])
  @@map("transactions")
}

model LineItem {
  id                  String      @id @default(uuid())
  transactionId       String
  transaction         Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  quantity            Decimal     @db.Decimal(12, 3)
  unitPrice           Decimal     @db.Decimal(12, 2)
  lineTotal           Decimal     @db.Decimal(12, 2)
  costPriceSnapshot   Decimal?    @db.Decimal(12, 2)

  @@index([transactionId])
  @@map("line_items")
}

// The raw-material catalog. Modelled in Phase 1 with no API at all until
// requirement 5 gave it one: this is what a branch orders from the warehouse.
//
// Business-wide by design, unlike Product, which grew a nullable branchId in
// requirement 4. A branch sells its own menu; it does not keep its own private
// list of flour.
model InventoryItem {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  unit       String
  category   String?

  // What the warehouse charges a branch for one `unit`. Nullable because an
  // item can be tracked for usage (Phase 1's original purpose) long before
  // anyone prices it — and an unpriced item cannot be ordered rather than
  // being ordered at zero.
  unitPrice Decimal? @db.Decimal(12, 2)

  // Withdrawn from the catalog without deleting it. Deleting would orphan the
  // history of every order that ever contained it.
  isActive Boolean @default(true)

  usageRecords     InventoryUsage[]
  supplyOrderItems SupplyOrderItem[]

  @@index([businessId])
  @@index([businessId, isActive])
  @@map("inventory_items")
}

// Daily usage/wastage per branch per item.
model InventoryUsage {
  id              String               @id @default(uuid())
  businessId      String
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem        @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  date            DateTime             @db.Date
  quantityUsed    Decimal              @db.Decimal(12, 3)
  quantityWasted  Decimal              @default(0) @db.Decimal(12, 3)
  wastageReason   String?
  costImpact      Decimal?             @db.Decimal(12, 2)
  source          InventoryUsageSource @default(MANUAL_ENTRY)

  @@index([businessId, branchId, date])
  @@map("inventory_usage")
}

// POS/HR record — distinct from User, because most cashiers/cooks never log
// into the app. userId links the two only when a staff member also has app
// access.
model StaffMember {
  id         String      @id @default(uuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  role       String
  externalId String?
  // Attendance/Salary module. Nullable: a StaffMember synced in from a POS
  // (Phase 1) has no payroll relationship with this app until an owner sets one.
  baseSalary Decimal?    @db.Decimal(12, 2)
  status     StaffStatus @default(ACTIVE)

  phone         String?
  // Human-facing payroll id, printed on the payslip. Distinct from externalId,
  // which is the id this person carries in a POS system. Deliberately not
  // @unique: unique-with-NULLs in Postgres would still allow any number of
  // staff with no code, so it buys nothing here.
  employeeCode  String?
  // Pro-rate a mid-month joiner or leaver. These shrink the NUMERATOR only —
  // days outside employment are excluded from present/absent but stay in
  // workingDays, so someone joining on the 15th earns roughly half a month.
  // Shrinking the divisor instead would pay them a full month, which is wrong.
  hiredOn       DateTime? @db.Date
  exitedOn      DateTime? @db.Date
  // Pairs with status, so a deactivation is auditable rather than just a flag.
  deactivatedAt DateTime?
  notes         String?

  transactions      Transaction[]
  attendanceRecords Attendance[]
  salarySlips       SalarySlip[]

  @@index([businessId, branchId])
  @@index([businessId, status])
  @@map("staff_members")
}

// ---------------------------------------------------------------------------
// Attendance & Salary Slip module
// ---------------------------------------------------------------------------
// Attendance is the payroll-facing daily record - exactly one row per staff
// member per calendar day - with the punch geolocation and the status payroll
// actually reads.
//
// It was deliberately never folded into the old `Shift` model, which was a
// POS/rota concept: schedulable without ever happening, attributable to a
// Transaction, and more than one per staff member per day. `Shift` was dropped
// in the working-days payroll migration having never been written to by any
// code path; a real rota feature would reintroduce it rather than overload
// this table.

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum SalarySlipStatus {
  DRAFT
  FINALIZED
}

model Attendance {
  id            String           @id @default(uuid())
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffMemberId String
  staffMember   StaffMember      @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  date          DateTime         @db.Date
  status        AttendanceStatus @default(PRESENT)
  punchInAt     DateTime?
  punchInLat    Decimal?         @db.Decimal(9, 6)
  punchInLng    Decimal?         @db.Decimal(9, 6)
  punchOutAt    DateTime?
  punchOutLat   Decimal?         @db.Decimal(9, 6)
  punchOutLng   Decimal?         @db.Decimal(9, 6)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Who overrode this day, when it wasn't a punch. A nullable FK rather than a
  // bare id string so the row survives the membership being deleted. Cheap to
  // record now and impossible to backfill later.
  markedByMembershipId String?
  markedBy             Membership? @relation(fields: [markedByMembershipId], references: [id], onDelete: SetNull)

  // Doubles as the "no double-punching" guard the reference doc calls for.
  @@unique([staffMemberId, date])
  @@index([businessId, branchId, date])
  @@map("attendance")
}

// One row per staff member per payroll month. Regenerating for the same
// (staffMemberId, monthYear) overwrites the previous DRAFT rather than
// accumulating duplicates - see payroll.service.js. A FINALIZED slip is
// immutable and regeneration is refused.
model SalarySlip {
  id            String      @id @default(uuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  monthYear     String

  // The basis, snapshotted at generation. Without these a later change to the
  // weekly off, the holiday calendar or the person's salary would silently
  // restate a payslip the employee has already been shown.
  baseSalary  Decimal @db.Decimal(12, 2)
  workingDays Decimal @db.Decimal(5, 2)

  // Itemised day buckets, so the payslip can show its own arithmetic.
  // The first four count working days only; weeklyOff and holiday are outside
  // the divisor entirely and are listed so the employee sees they were paid.
  daysPresent   Decimal @default(0) @db.Decimal(5, 2)
  daysHalfDay   Decimal @default(0) @db.Decimal(5, 2)
  daysAbsent    Decimal @default(0) @db.Decimal(5, 2)
  daysLeave     Decimal @default(0) @db.Decimal(5, 2)
  // Working days still in the future when the slip was generated mid-month.
  daysPending   Decimal @default(0) @db.Decimal(5, 2)
  daysWeeklyOff Decimal @default(0) @db.Decimal(5, 2)
  daysHoliday   Decimal @default(0) @db.Decimal(5, 2)

  totalDaysWorked Decimal          @db.Decimal(5, 2)
  grossPay        Decimal          @db.Decimal(12, 2)
  deductions      Decimal          @default(0) @db.Decimal(12, 2)
  deductionNote   String?
  netPay          Decimal          @db.Decimal(12, 2)
  currency        String
  status          SalarySlipStatus @default(DRAFT)
  generatedAt     DateTime         @default(now())
  finalizedAt     DateTime?

  @@unique([staffMemberId, monthYear])
  @@index([businessId, monthYear])
  @@index([businessId, branchId, monthYear])
  @@map("salary_slips")
}

// ---------------------------------------------------------------------------
// Counter billing — requirement 1
//
// "As orders come in the cashier adds them, issues a token, and the money keeps
// counting. Once an order is taken they can also edit it."
//
// Explicitly NOT a purchase flow like the supply order: no cart, no payment
// step, no fulfilment. It counts items, issues a token and shows a total.
//
// A CounterOrder is not a second sales fact table. Every mutation projects it
// into Transaction/LineItem through salesProjection.service.js, so
// getSalesSummary and every future metric keep reading one table — and because
// that projection is idempotent, "editable after placing" costs nothing.
// ---------------------------------------------------------------------------

model CounterOrder {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // What the customer is called by. Unique per branch per DAY, and restarting
  // each day is the point — a token is shouted across a counter, so it has to
  // stay small.
  tokenNumber Int
  // The branch's own local date, never UTC: a branch in Asia/Kolkata keyed on
  // UTC would restart its numbering at 05:30 local, mid-breakfast.
  tokenDate   DateTime @db.Date

  status CounterOrderStatus @default(OPEN)

  // Recomputed from the items on every mutation rather than adjusted, so it
  // cannot drift from the lines it is meant to total.
  totalAmount Decimal @db.Decimal(12, 2)
  currency    String

  // Optional. Requirement 1 has no payment step, so this defaults to
  // UNSPECIFIED rather than being guessed at — writing OTHER would put a
  // permanent lie into the cash-vs-digital mix metric Phase 5 computes.
  paymentMethod PaymentMethod @default(UNSPECIFIED)

  // Who rang it up, for the audit trail and for per-cashier figures later.
  placedByMembershipId String?
  placedByMembership   Membership? @relation(fields: [placedByMembershipId], references: [id], onDelete: SetNull)

  // The projection. SetNull rather than Cascade so deleting a transaction could
  // never silently orphan the order that explains it.
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt

  items CounterOrderItem[]

  // Not the allocator — BranchTokenCounter is. This is the assertion that the
  // allocator is correct, the same posture Attendance takes with its
  // no-double-punch unique key.
  @@unique([branchId, tokenDate, tokenNumber])
  @@index([businessId, branchId, tokenDate])
  @@index([businessId, branchId, status])
  @@map("counter_orders")
}

model CounterOrderItem {
  id             String       @id @default(uuid())
  counterOrderId String
  counterOrder   CounterOrder @relation(fields: [counterOrderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshotted at the moment it was rung up. A product renamed or repriced
  // next week must not rewrite what this receipt said.
  productNameSnapshot String
  quantity            Decimal @db.Decimal(12, 3)
  unitPrice           Decimal @db.Decimal(12, 2)
  lineTotal           Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([counterOrderId])
  @@map("counter_order_items")
}

// The token allocator. One row per branch per day, incremented by a single
// atomic `INSERT ... ON CONFLICT DO UPDATE ... RETURNING`.
//
// A MAX+1-and-retry would scan an index on every allocation and contend exactly
// when the counter is busiest — the failure mode being a 500 while a customer
// stands there. A Postgres sequence is the wrong shape: sequences are not
// per-branch-per-day, would need runtime DDL, and never reset.
model BranchTokenCounter {
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tokenDate  DateTime @db.Date
  lastNumber Int      @default(0)

  @@id([branchId, tokenDate])
  @@map("branch_token_counters")
}

// The floor on editing (requirement 17's day-end export).
//
// Requirement 1 asks for orders to stay editable after they are placed, but
// editability needs a floor: once a day has been closed and exported, changing
// one of its orders silently restates a number someone has already been shown.
// That is exactly the failure SalarySlip's FINALIZED rule exists to prevent.
model DayClose {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // The branch's own local date, matching CounterOrder.tokenDate.
  date DateTime @db.Date

  closedAt             DateTime    @default(now())
  closedByMembershipId String?
  closedByMembership   Membership? @relation(fields: [closedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([branchId, date])
  @@index([businessId, date])
  @@map("day_closes")
}

// ---------------------------------------------------------------------------
// Task 5 — Supply orders (requirements 3, 5, 5.1, 9, 11, 12)
//
// A branch orders raw material from one central warehouse desk, pays for it
// (recorded, never collected — see SupplyPaymentMode), and the desk accepts,
// packs and dispatches it. A delivery agent carries it and marks it delivered.
// Either of them can post a delay, which the cashier sees.
//
// Unlike CounterOrder this is NOT projected into Transaction/LineItem. A
// counter order is a sale — revenue, belonging in the sales fact table. A
// supply order is an internal transfer and a cost; writing it into the same
// table would inflate every sales figure in the product by the value of the
// flour a branch bought. It is a cost input to net profit (requirement 13)
// instead, and Task 8 reads it from here.
// ---------------------------------------------------------------------------

enum SupplyOrderStatus {
  DRAFT // the cart — the only status a branch can edit freely
  PLACED
  ACCEPTED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

// Requirement 5 is "pay online or cash on delivery", and the decision recorded
// in Docs/REQUIREMENTS.md is RECORD ONLY: no gateway, no money moving through
// this app. ONLINE means the cashier paid by some other means and typed the
// reference; the warehouse then confirms it against their own bank record.
enum SupplyPaymentMode {
  ONLINE
  COD
}

enum SupplyPaymentStatus {
  PENDING // nothing claimed yet — every COD order until it arrives
  PAID // the branch says it paid, and gave a reference
  VERIFIED // the warehouse found that reference in their own records
  FAILED // the warehouse looked and it was not there
}

enum SupplyOrderEventType {
  STATUS_CHANGE
  DELAY
  PAYMENT
  // Who is carrying it. Not a STATUS_CHANGE: handing a run to a different
  // agent moves nothing along the status machine, and recording it as one
  // would put a row in the timeline claiming a transition that never happened.
  ASSIGNMENT
}

model SupplyOrder {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // The number people say out loud. Null while the order is still a DRAFT
  // cart: numbering carts would burn numbers on things that never happened and
  // leave visible gaps the warehouse would ask about.
  orderNumber Int?

  status SupplyOrderStatus @default(DRAFT)

  // Recomputed from the items on every change, never adjusted, so it cannot
  // drift from the lines it totals.
  totalAmount Decimal @db.Decimal(12, 2)
  currency    String

  // Null on a DRAFT and required to leave it — placing an order is exactly the
  // moment the branch has to say how it is paying.
  paymentMode       SupplyPaymentMode?
  paymentStatus     SupplyPaymentStatus @default(PENDING)
  paymentReference  String?
  paymentVerifiedAt DateTime?

  // When the warehouse currently expects it to arrive. Optional: requirement 9
  // only asks for relative delays ("+30 minutes, traffic"), which are recorded
  // as events regardless. When a promise HAS been made, each delay pushes it,
  // so the cashier sees one moving time rather than doing the arithmetic.
  promisedAt DateTime?

  placedByMembershipId String?
  placedByMembership   Membership? @relation("SupplyOrderPlacedBy", fields: [placedByMembershipId], references: [id], onDelete: SetNull)

  deliveryAgentMembershipId String?
  deliveryAgentMembership   Membership? @relation("SupplyOrderDeliveryAgent", fields: [deliveryAgentMembershipId], references: [id], onDelete: SetNull)

  placedAt     DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items  SupplyOrderItem[]
  events SupplyOrderEvent[]

  @@unique([businessId, orderNumber])
  // The warehouse desk's query (requirement 3): every branch's orders, by
  // status, newest first.
  @@index([businessId, status])
  @@index([businessId, branchId, status])
  // The delivery agent's queue (requirement 12).
  @@index([deliveryAgentMembershipId, status])
  @@map("supply_orders")
}

model SupplyOrderItem {
  id            String      @id @default(uuid())
  supplyOrderId String
  supplyOrder   SupplyOrder @relation(fields: [supplyOrderId], references: [id], onDelete: Cascade)

  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  // Snapshotted, like CounterOrderItem: an item renamed or repriced next month
  // must not rewrite what this order said at the time.
  itemNameSnapshot String
  unitSnapshot     String
  quantity         Decimal @db.Decimal(12, 3)
  unitPrice        Decimal @db.Decimal(12, 2)
  lineTotal        Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  // One line per item, so adding the same thing twice raises the quantity
  // rather than producing two lines a picker has to reconcile. This is a cart,
  // not a till roll — which is why CounterOrderItem deliberately has no such
  // constraint.
  @@unique([supplyOrderId, inventoryItemId])
  @@index([supplyOrderId])
  @@map("supply_order_items")
}

// One table for material tracking, order tracking, the delays from BOTH the
// warehouse and the delivery agent, and the audit trail — requirement 5.1's
// whole list, which is one list because they are one stream of events.
//
// `reasonCode` is a CODE, never prose, for the same reason errors/catalog.js
// is: the server cannot know whether the reader wants Gujarati. The device
// renders `t('supplyDelay.' + reasonCode)`. `note` beside it is the actor's own
// free text, which is theirs and is shown verbatim.
model SupplyOrderEvent {
  id            String      @id @default(uuid())
  supplyOrderId String
  supplyOrder   SupplyOrder @relation(fields: [supplyOrderId], references: [id], onDelete: Cascade)

  type       SupplyOrderEventType
  fromStatus SupplyOrderStatus?
  toStatus   SupplyOrderStatus?

  delayMinutes Int?
  reasonCode   String?
  note         String?

  actorMembershipId String?
  actorMembership   Membership? @relation("SupplyOrderEventActor", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([supplyOrderId, createdAt])
  @@map("supply_order_events")
}

// Order numbering, allocated by the same atomic `INSERT ... ON CONFLICT DO
// UPDATE ... RETURNING` as BranchTokenCounter — see the note there for why a
// read-then-write MAX+1 is wrong.
//
// Per BUSINESS and never reset, unlike a token: an order number is referred to
// days later ("where is 214?"), so it has to stay unique over time rather than
// staying small.
model SupplyOrderCounter {
  businessId String   @id
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lastNumber Int      @default(0)

  @@map("supply_order_counters")
}

// ---------------------------------------------------------------------------
// Task 6 — Branch expenses (requirement 10)
//
// "Gas bill, electricity bill, petty expenses and everything else. Also daily
// cost: how much did I spend today? And how much did I sell today?"
//
// The counterpart to CounterOrder: that table is what a branch took in, this is
// what it paid out. Neither is projected into the other — a sale and a cost are
// different facts — and Task 8 reads both to arrive at net profit.
// ---------------------------------------------------------------------------

// What a branch spends money on.
//
// Per business rather than global, because one business's "Milk" is another's
// "Fuel" — and because a business that adds "Vegetables" must not add it to
// everybody else's list.
//
// ## Why a code AND a name
//
// Every business starts with the same seven categories, and those are shown to
// a cashier who may be reading the app in Gujarati. The backend cannot
// translate — it does not know the reader's language, which is the whole reason
// errors travel as codes. So a seeded category carries `code`, and the device
// renders `t('expenseCategory.<code>')`; `name` is the English fallback, the
// same role the English in errors/catalog.js plays.
//
// A category somebody types carries `code = null` and is shown verbatim,
// because their own words are not ours to translate.
//
// ## What is deliberately NOT here
//
// There is no "raw material" or "stock" category, and that is the answer to the
// double-count question REQUIREMENTS.md §5 raised: a supply order is already a
// cost recorded in SupplyOrder, so a category inviting someone to log it again
// by hand would subtract it twice from net profit. Task 8 reads supply spend
// from supply orders; expenses are everything else.
model ExpenseCategory {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Set for the seeded set, null for one somebody typed.
  code String?
  name String

  // Withdrawn rather than deleted: a category is on expenses already logged,
  // and deleting it would rewrite what those rows say they were for.
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  // Postgres treats NULLs as distinct, so this constrains the seeded set to one
  // row per code per business while leaving custom categories (code = null)
  // unconstrained by it — which is what the name key below is for.
  @@unique([businessId, code])
  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@map("expense_categories")
}

model Expense {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  amount   Decimal @db.Decimal(12, 2)
  currency String

  // The branch's own local date, exactly as CounterOrder.tokenDate is, so
  // "today's spend against today's sales" compares two figures drawn from the
  // same day. Keyed on UTC, a branch in Asia/Kolkata would file everything
  // spent before 05:30 against yesterday.
  expenseDate DateTime @db.Date

  // "Today I took ₹2,000 of milk" — the category carries the what, this
  // carries the detail that is nobody else's to translate.
  note String?

  // Cash or UPI, for the same cash-mix figure CounterOrder.paymentMethod
  // feeds. UNSPECIFIED rather than a guess, for the same reason.
  paymentMethod PaymentMethod @default(UNSPECIFIED)

  recordedByMembershipId String?
  recordedByMembership   Membership? @relation("ExpenseRecordedBy", fields: [recordedByMembershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The compliance query — "which branches logged nothing today" — is a
  // left join on (branchId, expenseDate), and the day view reads the same key.
  @@index([businessId, branchId, expenseDate])
  @@index([businessId, expenseDate])
  @@index([categoryId])
  @@map("expenses")
}
